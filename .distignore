# Files and directories excluded from the WordPress.org deployment.
# Used by 10up/action-wordpress-plugin-deploy (rsync excludes).

# Version control and CI
/.claude
/.git
/.github
/.distignore
/.gitignore

# Development directories
/node_modules
/src
/tests
/test-results
/playwright-report
/blob-report
/playwright
/vendor
/.wp-env.home

